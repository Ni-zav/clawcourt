# Shell-compatible example. Export these settings in your shell, or use
# node --env-file=.env src/server.mjs with a Node version that supports the flag.
PORT=4173
HOST=127.0.0.1

# Default workspace is a fresh copy of the bundled incident fixture per run.
# Use an absolute path to a disposable checkout to keep changes between runs.
# CLAWCOURT_WORKSPACE=/absolute/path/to/disposable-checkout

# Opt in to live agent execution.
# CLAWCOURT_ENABLE_OPENCLAW=1
# CLAWCOURT_OPENCLAW_BIN=openclaw
# CLAWCOURT_OPENCLAW_CONFIG=/absolute/path/to/openclaw.json
# CLAWCOURT_MODEL=ollama/qwen3:0.6b
# CLAWCOURT_FALLBACKS=ollama/qwen3.5:9b

# Opt in to executing reviewed test/build scripts in live or custom workspaces.
# CLAWCOURT_ALLOW_WORKSPACE_COMMANDS=1

# Optional. Without OpenClaw, the mock demo works with no credentials.
PORT=4173
HOST=127.0.0.1
# Absolute path for the only workspace ClawCourt is allowed to inspect/run inside.
# CLAWCOURT_WORKSPACE=/Users/you/projects/my-repo
# Optional explicit OpenClaw model; set to a model configured on your OpenClaw machine.
# CLAWCOURT_MODEL=ollama/qwen3.5:9b
# CLAWCOURT_FALLBACKS=openai/gpt-5.4,google/gemini-3.1-pro-preview
# CLAWCOURT_OPENCLAW_BIN=openclaw
